# ============================================
# 环境变量模板
# 复制本文件为 .env，并填入真实值
#   cp .env.example .env
# ============================================

# Deepseek LLM API Key（用于生成 AI 学习建议）
# 若未配置，系统会自动降级为规则化的模拟建议（不影响前端展示）
DEEPSEEK_API_KEY=your_key_here

# Deepseek API 地址（默认即可，一般无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions

# Deepseek 模型名
DEEPSEEK_MODEL=deepseek-chat
